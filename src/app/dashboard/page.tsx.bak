import Image from "next/image";
import Link from "next/link";
import {
  Activity,
  ArrowRight,
  ArrowUpRight,
  BadgeCheck,
  Banknote,
  Bell,
  Bird,
  CheckCircle2,
  ChevronRight,
  ClipboardList,
  Clock3,
  Egg,
  ExternalLink,
  Gift,
  HelpCircle,
  History,
  LayoutDashboard,
  ListChecks,
  LockKeyhole,
  MessageCircle,
  PackageCheck,
  Plus,
  Send,
  ShieldCheck,
  ShoppingCart,
  Sparkles,
  Sprout,
  TrendingUp,
  User,
  UserRound,
  Users,
  WalletCards,
} from "lucide-react";

import { CopyReferralButton } from "@/components/dashboard/copy-referral-button";
import { DashboardHeader } from "@/components/dashboard/dashboard-header";
import { EmptyState } from "@/components/shared/empty-state";
import { env } from "@/lib/env/server";
import { prisma } from "@/lib/database/prisma";
import { requireUser } from "@/lib/auth/session";
import { formatDateTime } from "@/lib/utilities/format";
import { getEggBalance } from "@/server/services/egg-ledger";

export const dynamic = "force-dynamic";

export default async function DashboardPage() {
  const user = await requireUser();
  const [
    activity,
    notifications,
    referralCount,
    activeHensAggregate,
    pendingPurchases,
    eggBalance,
    openSaleRequests,
    creditedReferralRewards,
    totalInvestmentAggregate,
    soldEggsAggregate,
    totalPaidAggregate,
    nextOrder,
    successfulLoginCount,
    referredBy,
  ] = await Promise.all([
    prisma.auditLog.findMany({
      where: { actorUserId: user.id },
      orderBy: { createdAt: "desc" },
      take: 4,
    }),
    prisma.notification.findMany({
      where: { userId: user.id },
      orderBy: { createdAt: "desc" },
      take: 3,
    }),
    prisma.referralRelationship.count({ where: { inviterId: user.id } }),
    prisma.henAsset.aggregate({
      where: { userId: user.id, status: "ACTIVE" },
      _sum: { quantity: true },
    }),
    prisma.purchaseOrder.count({
      where: {
        userId: user.id,
        status: { in: ["AWAITING_PAYMENT", "PAYMENT_SUBMITTED", "UNDER_REVIEW"] },
      },
    }),
    getEggBalance(user.id),
    prisma.eggSaleRequest.count({
      where: {
        userId: user.id,
        status: { in: ["AWAITING_REVIEW", "UNDER_REVIEW", "PAYMENT_PROCESSING"] },
      },
    }),
    prisma.referralReward.aggregate({
      where: { inviterUserId: user.id, status: "CREDITED" },
      _sum: { rewardEggUnits: true },
    }),
    prisma.purchaseOrder.aggregate({
      where: { userId: user.id, status: "APPROVED" },
      _sum: { totalAmountPaisa: true },
    }),
    prisma.eggSaleRequest.aggregate({
      where: { userId: user.id, status: "PAID" },
      _sum: { eggQuantity: true, totalAmountPaisa: true },
    }),
    prisma.payout.aggregate({
      where: { userId: user.id, status: "CONFIRMED" },
      _sum: { amountPaisa: true },
    }),
    prisma.purchaseOrder.findFirst({
      where: {
        userId: user.id,
        status: { in: ["AWAITING_PAYMENT", "PAYMENT_SUBMITTED", "UNDER_REVIEW"] },
      },
      orderBy: { createdAt: "desc" },
      select: { orderReference: true, status: true },
    }),
    prisma.auditLog.count({
      where: { actorUserId: user.id, action: "USER_LOGIN_SUCCEEDED" },
    }),
    prisma.referralRelationship.findUnique({
      where: { inviteeId: user.id },
      select: { inviter: { select: { username: true } } },
    }),
  ]);

  const isFirstVisit = successfulLoginCount === 0;
  const activeHens = activeHensAggregate._sum.quantity ?? 0;
  const soldEggs = soldEggsAggregate._sum.eggQuantity ?? 0;
  const totalInvestmentPaisa = totalInvestmentAggregate._sum.totalAmountPaisa ?? BigInt(0);
  const totalInvestmentRs = Math.round(Number(totalInvestmentPaisa) / 100);
  const referralBonusEggs = creditedReferralRewards._sum.rewardEggUnits ?? 0;
  const eggEarningsPaisa = soldEggsAggregate._sum.totalAmountPaisa ?? BigInt(0);
  const eggEarningsRs = Math.round(Number(eggEarningsPaisa) / 100);
  const totalPaidPaisa = totalPaidAggregate._sum.amountPaisa ?? BigInt(0);
  const totalPaidRs = Math.round(Number(totalPaidPaisa) / 100);
  const inviterName = referredBy?.inviter?.username ?? null;

  // Open Circular Illustrated Quick Shortcuts
  const quickShortcuts = [
    {
      label: "Plans",
      href: "/dashboard/plans",
      icon: ListChecks,
      bg: "from-[#F59B52] to-[#D8793F]",
      shadow: "shadow-amber-500/20",
    },
    {
      label: "Buy Hens",
      href: "/dashboard/plans",
      icon: ShoppingCart,
      bg: "from-[#F29A4A] to-[#E27D38]",
      shadow: "shadow-orange-500/20",
    },
    {
      label: "My Hens",
      href: "/dashboard/hens",
      icon: Bird,
      bg: "from-[#0D3850] to-[#061A2B]",
      shadow: "shadow-sky-950/25",
    },
    {
      label: "Egg Ledger",
      href: "/dashboard/egg-ledger",
      icon: Egg,
      bg: "from-[#E6A046] to-[#C97B28]",
      shadow: "shadow-amber-600/20",
    },
    {
      label: "Sell Eggs",
      href: "/dashboard/sell-eggs",
      icon: Banknote,
      bg: "from-[#2D9B78] to-[#1C7358]",
      shadow: "shadow-emerald-600/20",
    },
    {
      label: "Orders",
      href: "/dashboard/orders",
      icon: PackageCheck,
      bg: "from-[#09263A] to-[#04121A]",
      shadow: "shadow-slate-900/25",
    },
    {
      label: "Egg Sales",
      href: "/dashboard/egg-sales",
      icon: ClipboardList,
      bg: "from-[#D8793F] to-[#B55925]",
      shadow: "shadow-orange-700/20",
    },
    {
      label: "Referrals",
      href: "/dashboard/referrals",
      icon: Users,
      bg: "from-[#5B4699] to-[#3B2C68]",
      shadow: "shadow-purple-700/20",
    },
    {
      label: "Payments",
      href: "/dashboard/payout-methods",
      icon: WalletCards,
      bg: "from-[#2A8275] to-[#1B5E54]",
      shadow: "shadow-teal-700/20",
    },
    {
      label: "Profile",
      href: "/dashboard/profile",
      icon: UserRound,
      bg: "from-[#061A2B] to-[#0D3850]",
      shadow: "shadow-slate-950/25",
    },
  ];

  return (
    <div className="space-y-6 sm:space-y-8 animate-in fade-in duration-300">
      {/* 1. Header Section */}
      <DashboardHeader
        username={user.username}
        status={user.status}
        isFirstVisit={isFirstVisit}
      />

      {/* 2. First Summary Row (3 Reference Proportioned Cards) */}
      <section className="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6" aria-label="Overview Summary">
        {/* Card 1: Member Profile */}
        <div
          style={{
            boxShadow: "0 12px 28px rgba(16, 34, 45, 0.08), 0 3px 0 rgba(216, 121, 63, 0.18)",
          }}
          className="relative overflow-hidden rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-5 sm:p-6 flex flex-col justify-between group transition-transform hover:-translate-y-0.5"
        >
          <div className="flex items-start justify-between">
            <div className="flex items-center gap-3.5">
              <span className="grid size-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#F59B52] to-[#D8793F] text-white text-xl font-black shadow-md shadow-[#D8793F]/25">
                {user.username.slice(0, 1).toUpperCase()}
              </span>
              <div>
                <p className="text-[11px] font-black uppercase tracking-wider text-[#8C3A14]">
                  MEMBER PROFILE
                </p>
                <h3 className="flex items-center gap-1.5 text-lg font-black text-[#17372F]">
                  <span className="truncate max-w-[130px]">{user.username}</span>
                  <BadgeCheck size={18} className="text-[#D8793F] shrink-0" />
                </h3>
                {inviterName ? (
                  <p className="text-xs font-semibold text-[#566D7E] mt-0.5">
                    Sponsor: <span className="font-bold text-[#D8793F]">@{inviterName}</span>
                  </p>
                ) : (
                  <p className="text-xs font-semibold text-[#566D7E] mt-0.5">Direct Member</p>
                )}
              </div>
            </div>
            <span className="inline-flex items-center gap-1 rounded-full border border-emerald-600/30 bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-800">
              <span className="size-1.5 rounded-full bg-emerald-500 animate-pulse" />
              Active
            </span>
          </div>

          <div className="mt-5 pt-3.5 border-t border-[#17372F]/10 flex items-center justify-between">
            <span className="text-xs font-bold text-[#566D7E]">Flock Account</span>
            <Link
              href="/dashboard/profile"
              className="inline-flex items-center gap-1 text-xs font-black text-[#D8793F] hover:text-[#8C3A14] transition"
            >
              View Profile <ArrowRight size={13} />
            </Link>
          </div>
        </div>

        {/* Card 2: Available Eggs (Visually Dominant with 3D Golden Egg Image Overlap) */}
        <div
          style={{
            background: "linear-gradient(135deg, #FFFDF4 0%, #FFF3DF 100%)",
            boxShadow: "0 14px 32px rgba(216, 121, 63, 0.16), 0 3px 0 #D8793F",
          }}
          className="relative overflow-hidden rounded-3xl border-2 border-[#D8793F]/40 p-5 sm:p-6 flex flex-col justify-between group transition-transform hover:-translate-y-0.5"
        >
          <div className="relative z-10">
            <div className="flex items-center justify-between">
              <p className="text-[11px] font-black uppercase tracking-wider text-[#8C3A14]">
                AVAILABLE EGGS
              </p>
              <span className="inline-flex items-center gap-1 rounded-full bg-[#D8793F]/15 border border-[#D8793F]/30 px-2.5 py-0.5 text-[10px] font-extrabold text-[#8C3A14]">
                Ready to sell
              </span>
            </div>
            <h2 className="mt-2 text-3xl sm:text-4xl font-black text-[#17372F] tracking-tight">
              {eggBalance.toLocaleString()}
              <span className="text-base sm:text-lg font-bold text-[#8C3A14] ml-1.5">Eggs</span>
            </h2>
            <p className="text-xs font-semibold text-emerald-700 mt-1 flex items-center gap-1">
              <CheckCircle2 size={13} className="shrink-0" /> Verified in ledger
            </p>
          </div>

          {/* Large Overlapping 3D Golden Egg Image */}
          <div className="absolute right-2 bottom-1 size-24 sm:size-28 pointer-events-none transition-transform group-hover:scale-108 duration-300 drop-shadow-md">
            <Image
              src="/dashboard/golden-egg-3d.jpg"
              alt="Golden Egg"
              width={120}
              height={120}
              className="object-contain w-full h-full rounded-2xl"
            />
          </div>

          <div className="mt-5 pt-3.5 border-t border-[#17372F]/10 flex items-center gap-4 relative z-10">
            <Link
              href="/dashboard/sell-eggs"
              className="inline-flex items-center gap-1 text-xs font-black text-[#2D9B78] hover:underline"
            >
              Sell Eggs <ArrowRight size={13} />
            </Link>
            <Link
              href="/dashboard/egg-ledger"
              className="inline-flex items-center gap-1 text-xs font-bold text-[#D8793F] hover:text-[#8C3A14] transition"
            >
              Egg Ledger <ArrowRight size={13} />
            </Link>
          </div>
        </div>

        {/* Card 3: Active Flock (With 3D Brown Hen Overlap) */}
        <div
          style={{
            boxShadow: "0 12px 28px rgba(16, 34, 45, 0.08), 0 3px 0 rgba(216, 121, 63, 0.18)",
          }}
          className="relative overflow-hidden rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-5 sm:p-6 flex flex-col justify-between group transition-transform hover:-translate-y-0.5"
        >
          <div className="relative z-10">
            <div className="flex items-center justify-between">
              <p className="text-[11px] font-black uppercase tracking-wider text-[#8C3A14]">
                ACTIVE FLOCK
              </p>
              <span className="inline-flex items-center gap-1 rounded-full bg-amber-500/10 border border-amber-600/30 px-2.5 py-0.5 text-[10px] font-extrabold text-amber-800">
                Daily yield active
              </span>
            </div>
            <h2 className="mt-2 text-3xl sm:text-4xl font-black text-[#17372F] tracking-tight">
              {activeHens.toLocaleString()}
              <span className="text-base sm:text-lg font-bold text-[#566D7E] ml-1.5">Total hens</span>
            </h2>
            <p className="text-xs font-semibold text-[#D8793F] mt-1 flex items-center gap-1">
              <Sprout size={13} className="shrink-0" /> Producing daily eggs
            </p>
          </div>

          {/* Large Overlapping 3D Brown Hen Image */}
          <div className="absolute right-2 bottom-1 size-24 sm:size-28 pointer-events-none transition-transform group-hover:scale-108 duration-300 drop-shadow-md">
            <Image
              src="/dashboard/brown-hen-3d.jpg"
              alt="Brown Hen"
              width={120}
              height={120}
              className="object-contain w-full h-full rounded-2xl"
            />
          </div>

          <div className="mt-5 pt-3.5 border-t border-[#17372F]/10 flex items-center gap-4 relative z-10">
            <Link
              href="/dashboard/plans"
              className="inline-flex items-center gap-1 text-xs font-black text-[#D8793F] hover:text-[#8C3A14] transition"
            >
              Buy More Hens <ArrowRight size={13} />
            </Link>
            <Link
              href="/dashboard/hens"
              className="inline-flex items-center gap-1 text-xs font-bold text-[#09263A] hover:underline"
            >
              My Flock <ArrowRight size={13} />
            </Link>
          </div>
        </div>
      </section>

      {/* 3. Buy Hens & Sell Eggs Banners (Compact, Playful, Visual) */}
      <section className="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6" aria-label="Quick Actions">
        {/* Buy Hens Banner */}
        <div
          style={{
            background: "linear-gradient(135deg, #F59B52 0%, #D8793F 100%)",
            boxShadow: "0 14px 34px rgba(216, 121, 63, 0.35), 0 3px 0 #8C3A14",
          }}
          className="relative overflow-hidden rounded-3xl p-5 sm:p-7 text-white border border-[#FFD0A5]/40 flex items-center justify-between group transition-transform hover:-translate-y-1"
        >
          {/* Overlapping 3D Brown Hen Graphic on Left */}
          <div className="size-20 sm:size-24 shrink-0 rounded-2xl overflow-hidden shadow-md border-2 border-white/40 bg-white/20 mr-4 transition-transform group-hover:scale-105">
            <Image
              src="/dashboard/brown-hen-3d.jpg"
              alt="Buy Hens"
              width={96}
              height={96}
              className="object-cover w-full h-full"
            />
          </div>

          <div className="flex-1 min-w-0 pr-3">
            <span className="text-[11px] font-black uppercase tracking-wider text-white/90">
              Grow your flock
            </span>
            <h2 className="text-2xl sm:text-3xl font-black leading-tight text-white mt-0.5">
              Buy Hens
            </h2>
            <p className="text-xs text-white/85 mt-0.5 line-clamp-1">
              Add verified hens to start daily collection
            </p>
          </div>

          <Link
            href="/dashboard/plans"
            style={{
              backgroundColor: "#FFFDF4",
              color: "#8C3A14",
              boxShadow: "0 3px 0 #8C3A14, 0 8px 16px rgba(0,0,0,0.18)",
            }}
            className="inline-flex shrink-0 items-center gap-1.5 rounded-2xl px-4 sm:px-5 py-3 text-xs sm:text-sm font-black transition hover:bg-white active:translate-y-0.5"
          >
            <span>Buy Hens</span>
            <ArrowRight size={15} />
          </Link>
        </div>

        {/* Sell Eggs Banner */}
        <div
          style={{
            background: "linear-gradient(135deg, #0D3850 0%, #061A2B 100%)",
            boxShadow: "0 14px 34px rgba(6, 26, 43, 0.45), 0 3px 0 #04121A",
          }}
          className="relative overflow-hidden rounded-3xl p-5 sm:p-7 text-white border border-[#D8793F]/35 flex items-center justify-between group transition-transform hover:-translate-y-1"
        >
          {/* Overlapping 3D Egg Basket Graphic */}
          <div className="size-20 sm:size-24 shrink-0 rounded-2xl overflow-hidden shadow-md border-2 border-white/20 bg-white/10 mr-4 transition-transform group-hover:scale-105">
            <Image
              src="/dashboard/egg-basket-3d.jpg"
              alt="Sell Eggs"
              width={96}
              height={96}
              className="object-cover w-full h-full"
            />
          </div>

          <div className="flex-1 min-w-0 pr-3">
            <span className="text-[11px] font-black uppercase tracking-wider text-[#FFD0A5]">
              Turn eggs into value
            </span>
            <h2 className="text-2xl sm:text-3xl font-black leading-tight text-[#FFFDF4] mt-0.5">
              Sell Eggs
            </h2>
            <p className="text-xs text-[#DCE8E8]/85 mt-0.5 line-clamp-1">
              Convert eggs into direct bank payouts
            </p>
          </div>

          <Link
            href="/dashboard/sell-eggs"
            style={{
              background: "linear-gradient(180deg, #F59B52 0%, #D8793F 100%)",
              boxShadow: "0 3px 0 #04121A, 0 8px 16px rgba(0,0,0,0.25)",
            }}
            className="inline-flex shrink-0 items-center gap-1.5 rounded-2xl px-4 sm:px-5 py-3 text-xs sm:text-sm font-black text-white transition hover:brightness-105 active:translate-y-0.5"
          >
            <span>Sell Eggs</span>
            <ArrowRight size={15} />
          </Link>
        </div>
      </section>

      {/* 4. Referral Link & Pending Activity (2 Columns) */}
      <section className="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6" aria-label="Referral & Activity">
        {/* Referral Card */}
        <div
          style={{
            boxShadow: "0 12px 28px rgba(16, 34, 45, 0.08), 0 3px 0 rgba(216, 121, 63, 0.18)",
          }}
          className="rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-5 sm:p-6 flex flex-col justify-between"
        >
          <div>
            <div className="flex items-center justify-between">
              <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#D8793F]/15 text-[#8C3A14]">
                <Users size={13} /> GROW TOGETHER
              </span>
              <span className="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
                {referralCount} Members Joined
              </span>
            </div>

            <h3 className="mt-3.5 text-xl font-black text-[#17372F]">
              Your referral link
            </h3>
            <p className="mt-1 text-xs text-[#566D7E] leading-relaxed">

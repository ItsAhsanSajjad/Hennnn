            </span>
            <Link
              href="/dashboard/referrals"
              className="inline-flex items-center gap-1 text-xs font-black text-[#D8793F] hover:text-[#8C3A14] transition"
            >
              View Full Team <ArrowRight size={13} />
            </Link>
          </div>
        </div>

        {/* Pending Activity */}
        <div
          style={{
            boxShadow: "0 12px 28px rgba(16, 34, 45, 0.08), 0 3px 0 rgba(216, 121, 63, 0.18)",
          }}
          className="rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-5 sm:p-6 flex flex-col justify-between"
        >
          <div>
            <div className="flex items-center justify-between">
              <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#0D3850]/10 text-[#09263A]">
                <Clock3 size={13} /> IN PROCESS
              </span>
              <span className="text-xs font-bold text-[#566D7E]">Review Status</span>
            </div>

            <h3 className="mt-3.5 text-xl font-black text-[#17372F]">
              Pending activity
            </h3>
            <p className="mt-1 text-xs text-[#566D7E] leading-relaxed">
              Items waiting for payment review and settlement.
            </p>

            {/* 2 Compact Internal Visual Tiles */}
            <div className="mt-4 grid grid-cols-2 gap-3">
              <div className="rounded-2xl border border-[#D8793F]/20 bg-[#FFF8EC] p-3.5 flex items-center gap-3">
                <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-[#F59B52] to-[#D8793F] text-white shadow-xs">
                  <Bird size={20} />
                </span>
                <div>
                  <p className="text-xl font-black text-[#17372F]">{pendingPurchases}</p>
                  <p className="text-[11px] font-bold text-[#566D7E]">Pending Orders</p>
                </div>
              </div>

              <div className="rounded-2xl border border-[#D8793F]/20 bg-[#FFF8EC] p-3.5 flex items-center gap-3">
                <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-[#0D3850] text-[#FFD0A5] shadow-xs">
                  <Egg size={20} />
                </span>
                <div>
                  <p className="text-xl font-black text-[#17372F]">{openSaleRequests}</p>
                  <p className="text-[11px] font-bold text-[#566D7E]">Pending Sales</p>
                </div>
              </div>
            </div>
          </div>

          <div className="mt-4 pt-3 border-t border-[#17372F]/10 flex items-center justify-between">
            <span className="text-xs font-semibold text-[#566D7E]">
              {nextOrder ? `Order #${nextOrder.orderReference}` : "All orders synchronized"}
            </span>
            <Link
              href="/dashboard/orders"
              className="inline-flex items-center gap-1 text-xs font-black text-[#D8793F] hover:text-[#8C3A14] transition"
            >
              View Orders <ArrowRight size={13} />
            </Link>
          </div>
        </div>
      </section>

      {/* 5. WhatsApp Support Panel */}
      <section
        style={{
          boxShadow: "0 12px 28px rgba(16, 34, 45, 0.08), 0 3px 0 rgba(216, 121, 63, 0.18)",
        }}
        className="rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-5 sm:p-6"
        aria-label="WhatsApp Community Support"
      >
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <div>
            <span className="text-[11px] font-black uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-500/30">
              WE ARE HERE TO HELP
            </span>
            <h3 className="mt-1.5 text-xl font-black text-[#17372F]">
              WhatsApp Support
            </h3>
          </div>
        </div>

        <div className="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <a
            href="https://chat.whatsapp.com/growmeta-egg"
            target="_blank"
            rel="noopener noreferrer"
            className="flex items-center gap-3 p-3.5 rounded-2xl border border-[#25D366]/30 bg-[#25D366]/10 transition hover:bg-[#25D366]/20 group cursor-pointer"
          >
            <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-[#25D366] text-[#042010] shadow-xs group-hover:scale-105 transition">
              <MessageCircle size={20} />
            </span>
            <div className="min-w-0">
              <p className="text-xs font-black text-[#042010] truncate">WhatsApp Support</p>
              <p className="text-[11px] font-semibold text-[#566D7E]">Staff Helpdesk</p>
            </div>
          </a>

          <a
            href="https://whatsapp.com/channel/growmeta-egg"
            target="_blank"
            rel="noopener noreferrer"
            className="flex items-center gap-3 p-3.5 rounded-2xl border border-[#25D366]/30 bg-[#25D366]/10 transition hover:bg-[#25D366]/20 group cursor-pointer"
          >
            <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-[#25D366] text-[#042010] shadow-xs group-hover:scale-105 transition">
              <Send size={18} />
            </span>
            <div className="min-w-0">
              <p className="text-xs font-black text-[#042010] truncate">Official Channel</p>
              <p className="text-[11px] font-semibold text-[#566D7E]">Announcements</p>
            </div>
          </a>

          <a
            href="https://chat.whatsapp.com/growmeta-egg"
            target="_blank"
            rel="noopener noreferrer"
            className="flex items-center gap-3 p-3.5 rounded-2xl border border-[#25D366]/30 bg-[#25D366]/10 transition hover:bg-[#25D366]/20 group cursor-pointer"
          >
            <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-[#25D366] text-[#042010] shadow-xs group-hover:scale-105 transition">
              <Users size={18} />
            </span>
            <div className="min-w-0">
              <p className="text-xs font-black text-[#042010] truncate">Member Group</p>
              <p className="text-[11px] font-semibold text-[#566D7E]">Community Chat</p>
            </div>
          </a>

          <a
            href="https://chat.whatsapp.com/growmeta-egg"
            target="_blank"
            rel="noopener noreferrer"
            className="flex items-center gap-3 p-3.5 rounded-2xl border border-[#25D366]/30 bg-[#25D366]/10 transition hover:bg-[#25D366]/20 group cursor-pointer"
          >
            <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-[#25D366] text-[#042010] shadow-xs group-hover:scale-105 transition">
              <ShieldCheck size={18} />
            </span>
            <div className="min-w-0">
              <p className="text-xs font-black text-[#042010] truncate">Admin Helpline</p>
              <p className="text-[11px] font-semibold text-[#566D7E]">Payment Inquiries</p>
            </div>
          </a>
        </div>
      </section>

      {/* 6. Open Quick Access Section (NO BOXED WHITE CARD - OPEN ON SAND BACKGROUND) */}
      <section aria-label="Farm Shortcuts" className="pt-2">
        <div className="flex items-center justify-between mb-5">
          <div>
            <span className="text-[11px] font-black uppercase tracking-wider text-[#8C3A14]">
              QUICK ACCESS
            </span>
            <h3 className="text-xl sm:text-2xl font-black text-[#17372F]">
              Farm shortcuts
            </h3>
          </div>
          <span className="text-xs font-bold text-[#566D7E]">Tap to open</span>
        </div>

        {/* 10 Round Illustrated Buttons in 2 Rows */}
        <div className="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-4 sm:gap-6">
          {quickShortcuts.map((item) => {
            const Icon = item.icon;
            return (
              <Link
                key={item.label}
                href={item.href}
                className="group flex flex-col items-center justify-center text-center transition-transform hover:-translate-y-1.5 focus:outline-none"
              >
                {/* Circular Colored Illustrated Button */}
                <div
                  className={`size-16 sm:size-18 rounded-full bg-gradient-to-br ${item.bg} text-white grid place-items-center shadow-lg ${item.shadow} border-2 border-white/60 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-2`}
                >
                  <Icon size={24} className="transition-transform group-hover:scale-110" />
                </div>
                {/* Clean Label Underneath */}
                <span className="mt-2.5 text-xs sm:text-sm font-black text-[#17372F] group-hover:text-[#D8793F] transition-colors truncate w-full">
                  {item.label}
                </span>
              </Link>
            );
          })}
        </div>
      </section>

      {/* 7. Daily Egg Collection (Wide Feature Card) */}
      <section
        style={{
          boxShadow: "0 14px 34px rgba(16, 34, 45, 0.08), 0 3px 0 rgba(216, 121, 63, 0.18)",
        }}
        className="rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-5 sm:p-7 relative overflow-hidden"
        aria-label="Daily Egg Collection"
      >
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
          <div className="flex items-center gap-4 sm:gap-5">
            {/* 3D Golden Egg Graphic */}
            <div className="size-16 sm:size-20 shrink-0 rounded-2xl overflow-hidden shadow-md border-2 border-[#D8793F]/30 bg-[#FFF8EC]">
              <Image
                src="/dashboard/golden-egg-3d.jpg"
                alt="Egg Collection"
                width={80}
                height={80}
                className="object-cover w-full h-full"
              />
            </div>
            <div>
              <span className="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-[#D8793F]/15 text-[#8C3A14]">
                <Sparkles size={12} /> DAILY COLLECTION
              </span>
              <h2 className="mt-1 text-xl sm:text-2xl font-black text-[#17372F]">
                {activeHens > 0 ? "Daily Egg Collection" : "Start collecting eggs"}
              </h2>
              <p className="text-xs sm:text-sm text-[#566D7E] mt-0.5 max-w-xl">
                {activeHens > 0
                  ? `Your flock of ${activeHens} active hen${activeHens === 1 ? "" : "s"} is producing daily eggs.`
                  : "Buy your first hen plan to begin daily egg collection."}
              </p>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-3 shrink-0">
            <Link
              href="/dashboard/egg-ledger"
              className="inline-flex items-center gap-2 rounded-2xl border border-[#D8793F]/30 bg-[#FFF8EC] px-4 py-2.5 text-xs sm:text-sm font-bold text-[#8C3A14] hover:bg-[#FFF3DF] transition"
            >
              <Egg size={15} /> Open Ledger
            </Link>
            {activeHens > 0 ? (
              <Link
                href="/dashboard/sell-eggs"
                style={{
                  background: "linear-gradient(180deg, #F59B52 0%, #D8793F 100%)",
                  boxShadow: "0 3px 0 #8C3A14",
                }}
                className="inline-flex items-center gap-2 rounded-2xl px-5 py-2.5 text-xs sm:text-sm font-black text-white hover:brightness-105 transition"
              >
                <Banknote size={15} /> Sell Eggs
              </Link>
            ) : (
              <Link
                href="/dashboard/plans"
                style={{
                  background: "linear-gradient(180deg, #F59B52 0%, #D8793F 100%)",
                  boxShadow: "0 3px 0 #8C3A14",
                }}
                className="inline-flex items-center gap-2 rounded-2xl px-5 py-2.5 text-xs sm:text-sm font-black text-white hover:brightness-105 transition"
              >
                <ShoppingCart size={15} /> Buy a Hen
              </Link>
            )}
          </div>
        </div>
      </section>

      {/* 8. Farm Performance Statistics (7 Supported Farm Metrics) */}
      <section aria-label="Farm Performance">
        <div className="flex items-center justify-between mb-4">
          <div>
            <span className="text-[11px] font-black uppercase tracking-wider text-[#8C3A14]">
              FARM PERFORMANCE
            </span>
            <h3 className="text-xl sm:text-2xl font-black text-[#17372F]">
              Your farming stats
            </h3>
          </div>
          <span className="text-xs font-bold text-[#566D7E]">Real-Time Ledger</span>
        </div>

        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-4">
          {/* Stat 1: Total Hens */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group"
          >
            <p className="text-xs font-bold text-[#566D7E]">Total Hens</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-[#17372F]">{activeHens}</p>
            <p className="text-[11px] font-semibold text-emerald-700 mt-0.5">Active flock</p>
          </div>

          {/* Stat 2: Available Eggs */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group"
          >
            <p className="text-xs font-bold text-[#566D7E]">Available Eggs</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-[#D8793F]">{eggBalance}</p>
            <p className="text-[11px] font-semibold text-[#566D7E] mt-0.5">Ready for sale</p>
          </div>

          {/* Stat 3: Sold Eggs */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group"
          >
            <p className="text-xs font-bold text-[#566D7E]">Sold Eggs</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-[#17372F]">{soldEggs}</p>
            <p className="text-[11px] font-semibold text-emerald-700 mt-0.5">Completed sales</p>
          </div>

          {/* Stat 4: Total Investment */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group"
          >
            <p className="text-xs font-bold text-[#566D7E]">Total Investment</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-[#17372F]">
              Rs {totalInvestmentRs.toLocaleString()}
            </p>
            <p className="text-[11px] font-semibold text-[#566D7E] mt-0.5">Approved purchases</p>
          </div>

          {/* Stat 5: Referral Bonus */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group"
          >
            <p className="text-xs font-bold text-[#566D7E]">Referral Bonus</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-[#D8793F]">
              {referralBonusEggs} <span className="text-sm">Eggs</span>
            </p>
            <p className="text-[11px] font-semibold text-emerald-700 mt-0.5">Earned rewards</p>
          </div>

          {/* Stat 6: Egg Earnings */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group"
          >
            <p className="text-xs font-bold text-[#566D7E]">Egg Earnings</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-[#2D9B78]">
              Rs {eggEarningsRs.toLocaleString()}
            </p>
            <p className="text-[11px] font-semibold text-[#566D7E] mt-0.5">Paid out</p>
          </div>

          {/* Stat 7: Total Paid */}
          <div
            style={{
              boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
            }}
            className="rounded-3xl border border-[#D8793F]/20 bg-[#FFFDF4] p-4 relative overflow-hidden group col-span-2 sm:col-span-1"
          >
            <p className="text-xs font-bold text-[#566D7E]">Total Paid</p>
            <p className="mt-1 text-2xl sm:text-3xl font-black text-emerald-800">
              Rs {totalPaidRs.toLocaleString()}
            </p>
            <p className="text-[11px] font-semibold text-emerald-700 mt-0.5">Settled payouts</p>
          </div>
        </div>
      </section>

      {/* 9. Compact Recent Updates Bar */}
      <section
        style={{
          boxShadow: "0 8px 20px rgba(16, 34, 45, 0.06), 0 2px 0 rgba(216, 121, 63, 0.15)",
        }}
        className="rounded-3xl bg-[#FFFDF4] border border-[#D8793F]/25 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
        aria-label="Recent Updates"
      >
        <div className="flex items-center gap-3">
          <span className="grid size-10 place-items-center rounded-2xl bg-[#D8793F]/15 text-[#8C3A14]">
            <History size={20} />
          </span>
          <div>
            <h4 className="text-sm font-black text-[#17372F]">Account History &amp; Notices</h4>
            <p className="text-xs text-[#566D7E]">
              View your complete activity timeline and notifications
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2 self-end sm:self-auto">
          <Link
            href="/dashboard/activity"
            className="inline-flex items-center gap-1.5 rounded-xl border border-[#D8793F]/30 bg-[#FFF8EC] px-3.5 py-2 text-xs font-bold text-[#8C3A14] hover:bg-[#FFF3DF] transition"
          >
            <Activity size={14} /> Full Activity
          </Link>
          <Link
            href="/dashboard/notifications"
            className="inline-flex items-center gap-1.5 rounded-xl border border-[#D8793F]/30 bg-[#FFF8EC] px-3.5 py-2 text-xs font-bold text-[#8C3A14] hover:bg-[#FFF3DF] transition"
          >
            <Bell size={14} /> Notifications
          </Link>
        </div>
      </section>

      {/* 10. Farm Footer */}
      <footer className="pt-4 pb-6 text-center text-xs font-semibold text-[#566D7E] border-t border-[#D8793F]/20 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© 2026 GrowMeta Egg. All rights reserved.</p>
        <div className="flex items-center gap-4">
          <Link href="/dashboard/plans" className="hover:text-[#D8793F] transition">
            Plans
          </Link>
          <Link href="/dashboard/sell-eggs" className="hover:text-[#D8793F] transition">
            Sell Eggs
          </Link>
          <Link href="/dashboard/referrals" className="hover:text-[#D8793F] transition">
            Referrals
          </Link>
          <a
            href="https://chat.whatsapp.com/growmeta-egg"
            target="_blank"
            rel="noopener noreferrer"
            className="text-[#25D366] font-bold hover:underline"
          >
            WhatsApp Support
          </a>
        </div>
      </footer>
    </div>
  );
}



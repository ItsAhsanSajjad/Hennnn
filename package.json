{
  "name": "pakhen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "postinstall": "node scripts/ensure-env.js && prisma generate",
    "setup": "node scripts/ensure-env.js && npm install && prisma generate",
    "dev": "node scripts/ensure-env.js && next dev",
    "build": "node scripts/ensure-env.js && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:phase3": "vitest run tests/unit/phase3.test.ts tests/database/phase3-flow.test.ts --config vitest.db.config.ts",
    "test:concurrency": "vitest run tests/database/phase3-concurrency.test.ts --config vitest.db.config.ts",
    "test:a11y": "prisma generate && playwright test tests/e2e/phase3-a11y.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "prisma generate && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:promote": "tsx scripts/promote-superadmin.ts",
    "db:reset": "prisma migrate reset",
    "docker:up": "docker compose up -d postgres",
    "docker:test:up": "docker compose --profile test up -d postgres-test",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs postgres",
    "docker:reset": "tsx scripts/docker-reset.ts",
    "jobs:egg-accrual": "tsx scripts/run-egg-accrual.ts",
    "jobs:egg-accrual:dry-run": "tsx scripts/run-egg-accrual.ts --dry-run",
    "reconcile:phase3": "tsx scripts/reconcile-phase3.ts",
    "reconcile:phase3:json": "tsx scripts/reconcile-phase3.ts --json",
    "verify:production-env": "tsx scripts/verify-production-env.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:phase2": "pnpm prisma validate && pnpm db:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:phase3": "pnpm prisma format && pnpm prisma validate && pnpm db:generate && pnpm db:migrate:status && pnpm test && pnpm test:db && pnpm test:concurrency && pnpm test:e2e && pnpm test:a11y && pnpm build && pnpm audit && pnpm reconcile:phase3",
    "check:full": "pnpm prisma validate && pnpm db:generate && pnpm db:migrate:status && pnpm prisma migrate diff --exit-code --from-config-datasource --to-schema=prisma/schema.prisma && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm db:seed && pnpm db:seed && pnpm test:e2e && pnpm build && pnpm audit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "0.44.0",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.6.0",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "postcss": "8.5.17",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
